<?xml version="1.0" encoding="utf-8"?>
<!-- 品牌渐变底：与图标前景同款「雾蓝 → 淡紫」浅渐变（对角 #D7D1FC → #C6CCFC → #B6CEFB）。
     刻意不用原来那种又深又纯的紫，前景四颗新星的拖尾与星光才有呼吸空间。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0L108,0L108,108L0,108Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFD7D1FC"/>
                <item android:offset="0.52" android:color="#FFC6CCFC"/>
                <item android:offset="1" android:color="#FFB6CEFB"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
